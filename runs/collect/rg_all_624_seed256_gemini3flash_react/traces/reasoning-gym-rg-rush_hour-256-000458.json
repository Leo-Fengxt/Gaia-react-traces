 can_move:\\n                        new_state = curr_state.copy()\\n                        new_state[car] = tuple(new_coords)\\n                        state_tuple = tuple(sorted((k, v) for k, v in new_state.items()))\\n                        if state_tuple not in visited:\\n                            visited.add(state_tuple)\\n                            move_str = f\\\"{car}{'+' if delta > 0 else ''}{delta * steps}\\\"\\n                            queue.append((new_state, path + [move_str]))\\n                    else: break\\n    return 'No solution'\\nprint(solve())\"}",

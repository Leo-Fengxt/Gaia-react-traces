      "action_input": "{\"code\": \"def solve():\\n    n = 12\\n    # Pre-placed queens (row, col) 0-indexed\\n    fixed = [(3, 10), (4, 5), (5, 1), (6, 8)]\\n    \\n    def is_safe(queens, row, col):\\n        for r, c in queens:\\n            if r == row or c == col or abs(r - row) == abs(c - col):\\n                return False\\n        return True\\n\\n    def backtrack(row, queens):\\n        if row == n:\\n            return queens\\n        \\n        # If row is already occupied by a fixed queen\\n        for f_row, f_col in fixed:\\n            if f_row == row:\\n                return backtrack(row + 1, queens + [(f_row, f_col)])\\n        \\n        for col in range(n):\\n            if is_safe(queens + fixed, row, col):\\n                res = backtrack(row + 1, queens + [(row, col)])\\n                if res:\\n                    return res\\n        return None\\n\\n    solution_coords = backtrack(0, [])\\n    if solution_coords:\\n        board = [['_' for _ in range(n)] for _ in range(n)]\\n        for r, c in solution_coords:\\n            board[r][c] = 'Q'\\n        return '\\\\n'.join([' '.join(row) for row in board])\\n    return \\\"No solution\\\"\\n\\nprint(solve())\"}",

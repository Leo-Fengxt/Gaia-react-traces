um != col_targets[c]: continue\\n                \\n                # Heuristic: Remaining sum must be coverable by remaining count * max_val\\n                # Max possible remaining sum for this row: zeros_in_row[r] * 9\\n                # Min possible remaining sum for this row: zeros_in_row[r] * 1\\n                rem_row_sum = row_targets[r] - (curr_row_sums[r] + num)\\n                if rem_row_sum < zeros_in_row[r] * 1 or rem_row_sum > zeros_in_row[r] * 9:\\n                    continue\\n                rem_col_sum = col_targets[c] - (curr_col_sums[c] + num)\\n                if rem_col_sum < zeros_in_col[c] * 1 or rem_col_sum > zeros_in_col[c] * 9:\\n                    continue\\n\\n                # Place number\\n                matrix[r][c] = num\\n                curr_row_sums[r] += num\\n                curr_col_sums[c] += num\\n                counts[num] -= 1\\n                \\n                res = backtrack(idx + 1, counts)\\n                if res: return res\\n                \\n                # Backtrack\\n                counts[num] += 1\\n                curr_col_sums[c] -= num\\n                curr_row_sums[r] -= num\\n                matrix[r][c] = 0\\n\\n        zeros_in_row[r] += 1\\n        zeros_in_col[c] += 1\\n        return None\\n\\n    ans = backtrack(0, Counter(available_numbers))\\n    return ans\\n\\nresult = solve()\\nfor row in result: print(row)\"}",

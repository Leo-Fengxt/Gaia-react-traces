w_sum + val + (len(row_zeros)-1) > row_sums[r]: continue\\n                if len(col_zeros) > 1 and current_col_sum + val + (len(col_zeros)-1) > col_sums[c]: continue\\n\\n                matrix[r][c] = val\\n                counts[val] -= 1\\n                if backtrack(idx + 1):\\n                    return True\\n                counts[val] += 1\\n                matrix[r][c] = 0\\n        return False\\n\\n    if backtrack(0):\\n        for row in matrix:\\n            print(row)\\n    else:\\n        print(\\\"No solution\\\")\\n\\nsolve()\"}",
